from heapq import heappush, heappop

def heuristic(state, goal):
    distance = 0

    for i, value in enumerate(state):
        if value != 0:
            goal_index = goal.index(value)

            distance += abs(i // 3 - goal_index // 3)
            distance += abs(i % 3 - goal_index % 3)

    return distance


def solve(start, goal):
    pq = []

    heappush(pq, (heuristic(start, goal), 0, start, []))

    visited = set()

    while pq:

        f, cost, state, path = heappop(pq)

        if state == goal:
            return path + [state]

        if state in visited:
            continue

        visited.add(state)

        blank = state.index(0)

        row = blank // 3
        col = blank % 3

        moves = [
            (row - 1, col),
            (row + 1, col),
            (row, col - 1),
            (row, col + 1)
        ]

        for r, c in moves:

            if 0 <= r < 3 and 0 <= c < 3:

                new_state = list(state)

                new_blank = r * 3 + c

                new_state[blank], new_state[new_blank] = \
                    new_state[new_blank], new_state[blank]

                new_state = tuple(new_state)

                new_cost = cost + 1

                heappush(
                    pq,
                    (
                        new_cost + heuristic(new_state, goal),
                        new_cost,
                        new_state,
                        path + [state]
                    )
                )

    return None


start = tuple(
    map(int, input("Enter 9 values (0 for blank): ").split())
)

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

solution = solve(start, goal)

if solution:

    print("\nSolution:")

    for state in solution:
        print(state[:3])
        print(state[3:6])
        print(state[6:])
        print()

else:
    print("No solution found")
