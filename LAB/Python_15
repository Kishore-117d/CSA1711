# Decision Tree Classification

from sklearn.tree import DecisionTreeClassifier


X = [
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1],
    [2, 0],
    [2, 1]
]

y = [
    0,
    1,
    1,
    1,
    0,
    0
]


model = DecisionTreeClassifier(
    random_state=0
)

model.fit(X, y)


a = list(
    map(
        float,
        input(
            "Enter two feature values: "
        ).split()
    )
)

prediction = model.predict([a])

print(
    "Predicted Class:",
    prediction[0]
)
