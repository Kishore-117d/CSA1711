# Linear Regression

from sklearn.linear_model import LinearRegression


X = [
    [1],
    [2],
    [3],
    [4],
    [5]
]

y = [
    2,
    4,
    5,
    8,
    10
]


model = LinearRegression()

model.fit(X, y)


x = float(
    input(
        "Enter X value: "
    )
)

prediction = model.predict([[x]])

print(
    "Predicted Y:",
    prediction[0]
)
